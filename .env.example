# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Naver API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Crawler
CRAWL_USER_AGENT=LotteInsightBot/1.0
KBO_CRAWL_INTERVAL_HOURS=2

# Model (배포 시 경로 지정)
CLASSIFIER_MODEL_DIR=/app/models/classifier_koelectra
LOTTE_RELATED_MODEL_DIR=/app/models/lotte_related_koelectra
STANCE_CLASSIFIER_MODEL_DIR=/app/models/stance_koelectra
PLAYER_STANCE_CLASSIFIER_MODEL_DIR=/app/models/player_stance_koelectra
IS_LOTTE_RELATED_THRESHOLD=0.40
# GPT_SUMMARY_LABELS=["MATCH_RELATED","INJURY_ROSTER","TRANSACTION_CONTRACT"]  # 기본값 사용 시 불필요 (JSON 배열 문자열)

# App
APP_ENV=development
LOG_LEVEL=INFO